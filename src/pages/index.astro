---
const githubOrgUrl = 'https://github.com/outof0';

// Derived from `site` in astro.config.mjs so the canonical origin is declared once.
const siteUrl = Astro.site ?? new URL('https://outof0.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL('og-image.png', siteUrl).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'OutOf0',
  url: siteUrl.href,
  logo: new URL('brand/symbol-primary.svg', siteUrl).href,
  email: 'hello.outof0@gmail.com',
  description: 'OutOf0 builds developer products and open tools that move ideas from zero to impact.',
  sameAs: [githubOrgUrl],
};

const products = [
  {
    index: '01',
    name: 'Kitland',
    type: '64 local-first developer tools',
    description: 'A private workbench for formatting, encoding, generating, inspecting, and transforming developer data — no upload or account required.',
    url: 'https://kitland.dev',
  },
  {
    index: '02',
    name: 'GitView',
    type: 'Git workspace for VS Code',
    description: 'Resolve conflicts in a true three-way editor, then inspect history, branches, changes, and diffs.',
    url: 'https://gitview.dev',
  },
  {
    index: '03',
    name: 'AnyPick',
    type: 'AI coding account switcher',
    description: 'Switch accounts, route providers, and keep your AI coding tools moving without re-authenticating.',
    url: 'https://anypick.dev',
  },
];

const projects = [
  ['01', 'outof0 / kitland', 'A workbench of 64 private, local-first developer tools', 'https://github.com/outof0/kitland'],
  ['02', 'outof0 / gitview', 'True 3-way merge and a complete Git workspace for VS Code', 'https://github.com/outof0/gitview'],
  ['03', 'outof0 / anypick', 'Switch accounts and route providers for AI coding tools', 'https://github.com/outof0/anypick'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0D0F" />
    <meta name="description" content="OutOf0 builds developer products and open tools that move ideas from zero to impact." />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="OutOf0" />
    <meta property="og:title" content="OutOf0 — From zero, forward." />
    <meta property="og:description" content="Developer products and open tools for builders." />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="OutOf0 — From zero, forward." />
    <meta name="twitter:description" content="Developer products and open tools for builders." />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <title>OutOf0 — From zero, forward.</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="#top" aria-label="OutOf0, home">
          <img class="brand-symbol" src="/brand/symbol-primary.svg" alt="" width="29" height="29" />
          <img class="brand-wordmark" src="/brand/wordmark-ink.svg" alt="OutOf0" width="105" height="30" />
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="sr-only">Toggle navigation</span>
          <span></span><span></span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main navigation">
          <a href="#products">Products</a>
          <a href="#open-source">Open source</a>
          <a href="#about">About</a>
          <a class="nav-github" href={githubOrgUrl} target="_blank" rel="noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> A builder organization</p>
          <h1 id="hero-title">From zero,<br /><em>forward.</em></h1>
          <p class="hero-intro">OutOf0 builds developer products and open tools that move ideas from zero to impact.</p>
          <div class="button-row">
            <a class="button button-primary" href="#products">Explore products <span aria-hidden="true">↓</span></a>
            <a class="button button-secondary" href={githubOrgUrl} target="_blank" rel="noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-mark" aria-hidden="true">
          <span class="hero-mark-ring"></span>
          <span class="hero-mark-trace"></span>
          <div class="mark-orbit">OUT OF<br />ZERO</div>
          <img src="/brand/symbol-primary.svg" alt="" width="280" height="280" />
          <p>Build · Ship · Create</p>
        </div>
        <div class="hero-meta"><span>EST. 2026</span><span>MADE FOR BUILDERS</span><span>∞</span></div>
      </section>

      <section id="products" class="products section container" aria-labelledby="products-title">
        <div class="section-heading reveal">
          <p class="eyebrow"><span></span> The portfolio</p>
          <h2 id="products-title">Tools for<br />the next move.</h2>
          <p>Independent products, connected by a shared belief: the best tools leave room for people to think.</p>
        </div>
        <div class="product-list">
          {products.map((product) => (
            <article class="product-card reveal">
              <div class="product-number">{product.index}</div>
              <div>
                <p class="product-type">{product.type}</p>
                <h3>{product.name}</h3>
                <p>{product.description}</p>
              </div>
              <a href={product.url} target="_blank" rel="noreferrer" aria-label={`Visit ${product.name}`}>Visit site <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>

      <section id="about" class="manifesto" aria-labelledby="manifesto-title">
        <div class="container manifesto-inner">
          <p class="eyebrow eyebrow-light reveal"><span></span> The idea</p>
          <h2 id="manifesto-title" class="reveal">A blank page<br />isn't a void.<br /><em>It's a direction.</em></h2>
          <div class="manifesto-copy reveal">
            <p>Good products start with a choice to move. We build in public, share what we learn, and make useful things for people who make things.</p>
            <a href="#open-source">Read our principles <span aria-hidden="true">↓</span></a>
          </div>
          <div class="cut" aria-hidden="true"></div>
        </div>
      </section>

      <section id="open-source" class="open-source section container" aria-labelledby="oss-title">
        <div class="oss-heading reveal">
          <p class="eyebrow"><span></span> Built in the open</p>
          <h2 id="oss-title">Useful, visible,<br />shared.</h2>
        </div>
        <div class="project-list">
          {projects.map(([number, name, description, url]) => (
            <a class="project-row reveal" href={url} target="_blank" rel="noreferrer">
              <span class="project-index">{number}</span>
              <span class="project-name">{name}</span>
              <span class="project-description">{description}</span>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <a class="text-link reveal" href={githubOrgUrl} target="_blank" rel="noreferrer">Explore the GitHub organization <span aria-hidden="true">↗</span></a>
      </section>

      <section class="cta container" aria-labelledby="cta-title">
        <div class="reveal">
          <p class="eyebrow"><span></span> Start here</p>
          <h2 id="cta-title">Ready to move<br />from zero?</h2>
        </div>
        <div class="reveal">
          <p>Build, explore, contribute.<br />The next useful thing starts now.</p>
          <a class="button button-signal" href={githubOrgUrl} target="_blank" rel="noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-main">
        <a class="footer-brand" href="#top" aria-label="OutOf0, back to top">
          <img class="footer-symbol" src="/brand/symbol-reverse.svg" alt="" width="34" height="34" />
          <img class="footer-wordmark" src="/brand/wordmark-reverse.svg" alt="OutOf0" width="128" height="36" />
        </a>
        <p>Developer products and open tools.<br />From zero, forward.</p>
        <div class="footer-links">
          <a href="#products">Products</a><a href="#open-source">Open source</a><a href="#about">About</a><a href={githubOrgUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} OutOf0</span><span>Build · Ship · Create</span></div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.querySelector<HTMLElement>('.site-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; background: #fff; }
  :global(body) { margin: 0; color: #0b0d0f; background: #fff; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible), :global(button:focus-visible) { outline: 3px solid #39ff14; outline-offset: 4px; }
  .container { width: min(1180px, calc(100% - 64px)); margin-inline: auto; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .site-header { position: absolute; z-index: 2; top: 0; left: 0; width: 100%; }
  .nav-wrap { min-height: 96px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(11, 13, 15, .12); }
  .brand { display: flex; align-items: center; gap: 9px; height: 38px; }
  .brand-symbol { width: 29px; height: 29px; flex: none; }
  .brand-wordmark { width: 118px; height: auto; transform: translateY(2px); }
  .site-nav { display: flex; align-items: center; gap: 28px; font-size: 14px; font-weight: 600; letter-spacing: -.01em; }
  .site-nav > a:not(.nav-github) { color: #4d5259; transition: color .2s ease; }
  .site-nav > a:not(.nav-github):hover { color: #0b0d0f; }
  .nav-github { padding: 11px 15px; background: #0b0d0f; color: #fff; border-radius: 4px; }
  .nav-toggle { display: none; }
  .hero { min-height: min(825px, 100svh); padding-top: 206px; position: relative; display: grid; grid-template-columns: 1.1fr .9fr; align-content: center; overflow: hidden; }
  .hero-copy { position: relative; z-index: 1; padding-bottom: 88px; animation: rise-in .85s cubic-bezier(.16, 1, .3, 1) both; }
  .eyebrow { display: flex; gap: 9px; align-items: center; margin: 0 0 25px; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .eyebrow span { width: 8px; height: 8px; background: #39ff14; border-radius: 50%; display: inline-block; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { font-family: "Arial Narrow", "Inter Tight", Inter, sans-serif; font-weight: 800; letter-spacing: -.075em; }
  h1 { max-width: 700px; margin-bottom: 28px; font-size: clamp(64px, 9.6vw, 138px); line-height: .86; }
  h1 em, h2 em { font-family: Georgia, serif; font-weight: 400; letter-spacing: -.09em; }
  .hero-intro { max-width: 450px; margin-bottom: 34px; color: #50555c; font-size: 18px; line-height: 1.55; letter-spacing: -.02em; }
  .button-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .button { display: inline-flex; align-items: center; gap: 23px; padding: 15px 18px; border-radius: 5px; font-size: 14px; font-weight: 700; transition: transform .2s ease, background .2s ease; }
  .button:hover { transform: translateY(-2px); }
  .button-primary { background: #0b0d0f; color: #fff; }
  .button-secondary { border: 1px solid #cdd0d3; }
  .hero-mark { position: relative; place-self: center end; width: min(29vw, 350px); aspect-ratio: 1; margin-top: -60px; animation: mark-enter 1.1s .15s cubic-bezier(.16, 1, .3, 1) both; }
  .hero-mark img { width: 100%; height: 100%; position: relative; z-index: 1; animation: mark-float 5s 1.15s ease-in-out infinite; }
  .hero-mark-ring { position: absolute; z-index: 0; inset: -13%; border: 1px solid #dfe1e3; border-radius: 50%; animation: ring-spin 18s linear infinite; }
  .hero-mark-ring::before, .hero-mark-ring::after { content: ""; position: absolute; width: 5px; height: 5px; background: #39ff14; border-radius: 50%; }
  .hero-mark-ring::before { top: 0; left: 50%; }
  .hero-mark-ring::after { right: 9%; bottom: 11%; background: #0b0d0f; }
  .hero-mark-trace { position: absolute; z-index: 0; left: -25%; top: 51%; width: 58%; height: 1px; background: #0b0d0f; transform-origin: right; animation: trace-pulse 2.8s 1.3s ease-in-out infinite; }
  .mark-orbit { position: absolute; z-index: 2; inset: -15%; padding-top: 5%; color: #787d83; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px; line-height: 1.3; letter-spacing: .18em; transform: rotate(-36deg); animation: orbit-drift 8s ease-in-out infinite; }
  .hero-mark p { position: absolute; right: -7px; bottom: -22px; z-index: 2; margin: 0; padding: 5px 7px; background: #39ff14; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px; font-weight: 700; letter-spacing: .04em; animation: tag-pulse 2.8s 1.2s ease-in-out infinite; }
  .hero-meta { position: absolute; bottom: 30px; left: 0; right: 0; display: flex; justify-content: space-between; font-family: "JetBrains Mono", ui-monospace, monospace; color: #73787e; font-size: 10px; letter-spacing: .09em; }
  .section { padding-top: 156px; padding-bottom: 156px; }
  .products { display: grid; grid-template-columns: .82fr 1.18fr; gap: 110px; border-top: 1px solid #d9dcdf; }
  .section-heading h2, .oss-heading h2, .cta h2 { margin-bottom: 0; font-size: clamp(45px, 5.4vw, 76px); line-height: .93; }
  .section-heading > p:last-child { max-width: 330px; margin: 30px 0 0; color: #666b71; font-size: 16px; line-height: 1.55; }
  .product-list { border-top: 1px solid #0b0d0f; }
  .product-card { position: relative; min-height: 196px; display: grid; grid-template-columns: 42px 1fr auto; gap: 20px; align-items: start; padding: 27px 0; border-bottom: 1px solid #d9dcdf; transition: padding .25s ease, background .25s ease; }
  .product-card::before { content: ""; position: absolute; top: -1px; left: 0; width: 0; height: 2px; background: #39ff14; transition: width .38s cubic-bezier(.16, 1, .3, 1); }
  .product-card:hover { padding-left: 10px; background: #fafafa; }
  .product-card:hover::before { width: 100%; }
  .product-number, .product-type, .project-index { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: .04em; }
  .product-number { color: #72777d; padding-top: 6px; }
  .product-type { margin-bottom: 7px; color: #72777d; text-transform: uppercase; }
  .product-card h3 { margin-bottom: 12px; font-size: 29px; letter-spacing: -.055em; }
  .product-card div > p:last-child { max-width: 368px; margin-bottom: 0; color: #646970; line-height: 1.5; font-size: 15px; }
  .product-card a { padding-top: 7px; white-space: nowrap; font-size: 13px; font-weight: 700; }
  .product-card a span, .text-link span { color: #149c00; font-size: 16px; }
  .manifesto { background: #0b0d0f; color: #fff; overflow: hidden; }
  .manifesto-inner { position: relative; min-height: 635px; padding-top: 128px; padding-bottom: 125px; }
  .eyebrow-light { color: #aeb2b6; }
  .manifesto h2 { position: relative; z-index: 1; margin-bottom: 0; font-size: clamp(52px, 7.4vw, 105px); line-height: .88; }
  .manifesto h2 em { color: #39ff14; }
  .manifesto-copy { position: relative; z-index: 1; width: min(335px, 100%); margin: 58px 0 0 auto; }
  .manifesto-copy p { color: #b2b6ba; font-size: 17px; line-height: 1.55; }
  .manifesto-copy a { display: inline-flex; gap: 18px; margin-top: 8px; color: #39ff14; font-size: 14px; font-weight: 700; }
  .cut { position: absolute; right: 7%; top: -164px; width: 430px; height: 830px; border: 1px solid #303438; border-radius: 50%; transform: rotate(-27deg); animation: cut-drift 12s ease-in-out infinite; }
  .cut::after { content: ""; position: absolute; top: 47%; right: -46px; width: 165px; height: 19px; background: #39ff14; transform: rotate(27deg); animation: cut-signal 2.8s ease-in-out infinite; }
  .open-source { display: grid; grid-template-columns: .82fr 1.18fr; gap: 110px; align-items: start; }
  .project-list { border-top: 1px solid #0b0d0f; }
  .project-row { display: grid; grid-template-columns: 52px 1.15fr 1fr 24px; gap: 15px; align-items: center; padding: 21px 0; border-bottom: 1px solid #d9dcdf; transition: padding .2s ease, color .2s ease, background .2s ease; }
  .project-row:hover { color: #149c00; padding-left: 9px; }
  .project-index { color: #767b81; }
  .project-name { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 13px; font-weight: 700; }
  .project-description { color: #676c72; font-size: 13px; }
  .project-arrow { text-align: right; font-size: 19px; }
  .text-link { display: inline-flex; gap: 10px; margin-top: 27px; font-size: 14px; font-weight: 700; }
  .cta { min-height: 450px; display: grid; grid-template-columns: 1fr .64fr; gap: 60px; align-items: center; padding-top: 82px; padding-bottom: 82px; border-top: 1px solid #d9dcdf; }
  .cta > div:last-child > p { margin-bottom: 30px; color: #676c72; font-size: 17px; line-height: 1.55; }
  .button-signal { background: #39ff14; }
  .site-footer { background: #0b0d0f; color: #fff; }
  .footer-main { display: grid; grid-template-columns: 1fr 1fr auto; gap: 40px; padding-top: 55px; padding-bottom: 60px; }
  .footer-main > p { margin: 0; color: #aeb2b6; font-size: 14px; line-height: 1.5; }
  .footer-brand { position: relative; display: flex; align-items: center; gap: 11px; width: max-content; height: 42px; }
  .footer-symbol { width: 34px; height: 34px; flex: none; }
  .footer-wordmark { width: 137px; height: auto; transform: translateY(2px); }
  .footer-brand::after { content: ""; position: absolute; left: 45px; right: 5px; bottom: 0; height: 1px; background: #39ff14; transform: scaleX(.2); transform-origin: left; transition: transform .35s ease; }
  .footer-brand:hover::after { transform: scaleX(1); }
  .footer-links { display: grid; grid-template-columns: repeat(2, auto); gap: 12px 38px; font-size: 13px; font-weight: 600; }
  .footer-links a:hover { color: #39ff14; }
  .footer-bottom { display: flex; justify-content: space-between; padding-top: 17px; padding-bottom: 20px; border-top: 1px solid #303438; color: #8a8e93; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px; letter-spacing: .06em; }
  .reveal { opacity: 0; transform: translateY(20px); transition: opacity .7s cubic-bezier(.16, 1, .3, 1), transform .7s cubic-bezier(.16, 1, .3, 1); }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }
  .product-card:nth-child(2), .project-row:nth-child(2) { transition-delay: .08s; }
  .product-card:nth-child(3), .project-row:nth-child(3) { transition-delay: .16s; }
  @keyframes rise-in { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes mark-enter { from { opacity: 0; transform: translate3d(34px, 20px, 0) scale(.9); } to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); } }
  @keyframes mark-float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-10px) rotate(2deg); } }
  @keyframes ring-spin { to { transform: rotate(360deg); } }
  @keyframes trace-pulse { 0%, 100% { transform: scaleX(.55); opacity: .4; } 50% { transform: scaleX(1); opacity: 1; } }
  @keyframes orbit-drift { 0%, 100% { transform: rotate(-36deg) translate(0); } 50% { transform: rotate(-36deg) translate(7px, -5px); } }
  @keyframes tag-pulse { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @keyframes cut-drift { 0%, 100% { transform: rotate(-27deg) translateY(0); } 50% { transform: rotate(-24deg) translateY(14px); } }
  @keyframes cut-signal { 0%, 100% { box-shadow: 0 0 0 rgba(57, 255, 20, 0); } 50% { box-shadow: 0 0 24px rgba(57, 255, 20, .32); } }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    .reveal { opacity: 1; transform: none; }
  }
  @media (min-width: 761px) and (max-width: 960px) {
    .container { width: min(100% - 72px, 900px); }
    .hero { grid-template-columns: 1fr .7fr; padding-top: 180px; }
    .hero-mark { width: min(32vw, 270px); }
    .products, .open-source { gap: 54px; grid-template-columns: .75fr 1.25fr; }
    .section { padding-top: 112px; padding-bottom: 112px; }
    .product-card { grid-template-columns: 34px 1fr; gap: 14px; min-height: 214px; }
    .product-card a { grid-column: 2; padding-top: 0; }
    .project-row { grid-template-columns: 42px 1fr 24px; }
    .project-description { display: none; }
    .cta { gap: 38px; }
  }
  @media (max-width: 760px) {
    .container { width: min(100% - 40px, 580px); }
    .nav-wrap { min-height: 72px; }
    .brand { gap: 7px; }
    .brand-symbol { width: 25px; height: 25px; }
    .brand-wordmark { width: 105px; }
    .nav-toggle { position: relative; z-index: 3; display: grid; gap: 5px; width: 39px; height: 39px; padding: 10px; border: 0; background: none; cursor: pointer; }
