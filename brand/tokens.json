{
  "$schema": "https://example.com/design-tokens.schema.json",
  "brand": {
    "name": "OutOf0",
    "tagline": "From zero, forward.",
    "url": "outof0.dev"
  },
  "color": {
    "brand.ink": "#0B0D0F",
    "brand.steel": "#6B6F76",
    "brand.mist": "#E7E9EC",
    "brand.white": "#FFFFFF",
    "brand.signal": "#39FF14",
    "surface.light": "#FFFFFF",
    "surface.dark": "#0B0D0F",
    "text.default": "#0B0D0F",
    "text.inverse": "#FFFFFF",
    "semantic.success": "#22C55E",
    "semantic.warning": "#F59E0B",
    "semantic.error": "#EF4444",
    "semantic.info": "#3B82F6"
  },
  "font": {
    "fontFamily": {
      "display": "Satoshi, Inter, system-ui, sans-serif",
      "body": "Inter, system-ui, sans-serif",
      "mono": "JetBrains Mono, ui-monospace, monospace"
    },
    "fontSize": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 36,
      "5xl": 48,
      "6xl": 64
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "pill": 999
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 40,
    "4xl": 56
  },
  "icon": {
    "avatarSizes": [
      1024,
      512,
      256,
      192,
      128,
      64,
      32,
      16
    ],
    "minimumLogoHeight": {
      "fullLogo": 24,
      "wordmark": 18,
      "symbol": 16
    }
  }
}